{
  "name": "novotek-pick-to-light-app",
  "version": "1.0.0",
  "description": "Editable NOVOTEK Pick-to-Light desktop prototype",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:localhost": "node server.js",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.novotek.picktolight",
    "productName": "NOVOTEK Pick-to-Light Prototype",
    "npmRebuild": false,
    "files": [
      "preload.js",
      "main.js"
    ],
    "extraResources": [
      {
        "from": "../website",
        "to": "website",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "serialport": "^13.0.0"
  },
  "allowScripts": {
    "@serialport/bindings-cpp@13.0.0": true
  }
}
